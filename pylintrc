[MAIN]
load-plugins=
jobs=0
persistent=yes

[MESSAGES CONTROL]
disable=
    C0103,  # invalid-name
    C0111,  # missing-docstring
    R0903,  # too-few-public-methods
    W0212,  # protected-access
    C0415,  # import-outside-toplevel
    W0613,  # unused-argument
    C0114,  # missing-module-docstring

[REPORTS]
output-format=text
reports=no
score=yes

[REFACTORING]
max-nested-blocks=5

[BASIC]
good-names=
    i,
    j,
    k,
    ex,
    Run,
    _,
    id,
    ip

[FORMAT]
max-line-length=100
indent-string='    '

[VARIABLES]
init-import=no
dummy-variables-rgx=_+$|(_[a-zA-Z0-9_]*[a-zA-Z0-9]+?$)|dummy|^ignored_|^unused_

[SIMILARITIES]
min-similarity-lines=4
ignore-comments=yes
ignore-docstrings=yes
ignore-imports=no

[MISCELLANEOUS]
notes=FIXME,XXX,TODO

[TYPECHECK]
ignore-mixin-members=yes
ignored-modules=
ignored-classes=
